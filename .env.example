# Copy to .env and fill in. The real .env is gitignored.
#
# Supabase project credentials
# ----------------------------
# Password you set when creating the Supabase project.
SUPABASE_DB_PASSWORD=

# Database connection strings — from Supabase Dashboard → "Connect" button.
#
# Direct (port 5432, host db.<project-ref>.supabase.co) — IPv6-only on free tier.
# Use for local development if your network has IPv6; otherwise use pooled.
SUPABASE_DB_URL=

# Transaction pooler (port 6543, host aws-0-<region>.pooler.supabase.com) — IPv4.
# Required for GitHub Actions. Safe to use everywhere.
SUPABASE_DB_URL_POOLED=

# REST / client credentials — from Supabase Dashboard → Project Settings → API.
# Used by the Streamlit app for public reads.
SUPABASE_URL=
SUPABASE_ANON_KEY=
